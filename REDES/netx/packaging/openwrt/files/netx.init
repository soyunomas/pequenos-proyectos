#!/bin/sh /etc/rc.common

USE_PROCD=1
START=90
STOP=10

start_service() {
	config_load netx
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get listen main listen '0.0.0.0'
	config_get port main port '5202'
	config_get cpu main cpu '-1'
	config_get numa_node main numa_node '-1'

	procd_open_instance
	procd_set_param command /usr/bin/netx server --listen "$listen" --port "$port"
	[ "$cpu" -ge 0 ] && procd_append_param command --cpu "$cpu"
	[ "$numa_node" -ge 0 ] && procd_append_param command --numa-node "$numa_node"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
